include "types.fbs";

namespace IgAsset;

//
// GEOMETRY
//

enum IndexFormat : byte { Uint16 = 1, Uint32 }

table DracoGeometry {
  pos_attrib: int8 = -1;
  normal_attrib: int8 = -1;
  tangent_attrib: int8 = -1;
  bitangent_attrib: int8 = -1;
  texcoord_attrib: int8 = -1;
  bone_idx_attrib: int8 = -1;
  bone_weight_attrib: int8 = -1;

  draco_bin: [ubyte];
  index_format: IndexFormat = Uint16;

  ozz_bone_names: [string];
  ozz_inv_bind_poses: [Mat4];
}

//
// SHADER
//
table WgslSource {
  source: string;

  vertex_entry_point: string;
  fragment_entry_point: string;
  compute_entry_point: string;
}

//
// ANIMATION
//
table OzzSkeleton {
  ozz_data: [ubyte];
}

table OzzAnimation {
  ozz_data: [ubyte];
  bone_names: [string];
}

//
// IMAGES
//
table Image2D {
  encoding: Image2DEncoding = RGBA8Unorm;
  width: uint32;
  height: uint32;
  data: [ubyte];
}

table Spritesheet {
  image: Image2D;
  sprites: [IgAsset.Sprite];
}

//
// AGGREGATE / BUNDLES
//
union SingleAssetData {
  WgslSource,
  DracoGeometry,
  OzzSkeleton,
  OzzAnimation,
  Image2D,
  Spritesheet
}

table Asset {
  asset: SingleAssetData;
}

root_type Asset;
