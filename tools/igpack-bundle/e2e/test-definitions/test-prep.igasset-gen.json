{
  "actions": [
    {
      "action_type": "CopyWgslSourceAction",
      "action": {
        "input_file_path": "copy-wgsl-source.wgsl",
        "output_file_path": "simple-wgsl.igasset",
        "vertex_entry_point": "vertex-main",
        "fragment_entry_point": "fragment-main",
        "compute_entry_point": "compute-main"
      }
    },
    {
      "action_type": "ImageToTexture2DAction",
      "action": {
        "input_file_path": "glass.png",
        "outputs": [
          {
            "output_file_path": "glass-etc1s.igasset",
            "image_encoding": "ETC1S",
            "width": 512,
            "height": 512
          },
          {
            "output_file_path": "glass-rgba8.igasset",
            "image_encoding": "RGBA8Unorm",
            "width": 512,
            "height": 512
          }
        ]
      }
    }
  ]
}
