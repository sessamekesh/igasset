include "igasset.fbs";

namespace IgPackGen;

table IgassetSource {
  file_path: string;
  igasset_name: string;
}

table SingleIgpackGenAction {
  output_path: string;
  igasset_sources: [IgassetSource];
}

table IgpackGenPlan {
  igpack_gen_actions: [SingleIgpackGenAction];
}

root_type IgpackGenPlan;
